---
// Site footer (decision #120): only our social accounts and "© year Nyamira Daily". Everything that used to sit
// here (the publisher line, the trust pages, licences) lives under About; map credits sit on the maps themselves.
// Social icons show only for accounts set in src/config.js `social`.
import Icon from './Icon.astro';
import { socialLinks } from '../config.js';
import { county } from '../county.js';
const names = { whatsapp: 'WhatsApp Channel', youtube: 'YouTube', facebook: 'Facebook', x: 'X', instagram: 'Instagram', tiktok: 'TikTok' };
---
<footer class="site-footer">
  <div class="wrap ft-min">
    {socialLinks.length > 0 && (
      <ul class="ft-social" aria-label={`${county.siteName} on social media`}>
        {socialLinks.map(([k, url]) => (
          <li><a href={url} rel="noopener me" aria-label={`${county.siteName} on ${names[k] ?? k}`}><Icon name={k} size={22} /></a></li>
        ))}
      </ul>
    )}
    <p class="ft-copy">© {new Date().getFullYear()} {county.siteName}</p>
  </div>
</footer>
