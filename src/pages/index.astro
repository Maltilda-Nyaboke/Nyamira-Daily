---
// Home (decision #110): the map first, then one money band, then the places, then the topics as a short list.
// No podcast, news or alerts. The number of the week sits beside the year's money, since both are money figures.
import Base from '../layouts/Base.astro';
import HeroMap from '../components/HeroMap.astro';
import EvidenceLabel from '../components/EvidenceLabel.astro';
import SplitBar from '../components/viz/SplitBar.astro';
import NumberCard from '../components/NumberCard.astro';
import { getNumbers } from '../lib/numbers.js';
import wards from '../data/wards.js';
import { topics, topicPath } from '../data/topics.js';
import Icon from '../components/Icon.astro';
import { topicIcon } from '../lib/icons.js';
import money from '../lib/county-money.js';

const [numberNow] = await getNumbers();
const facilities = wards.reduce((n, w) => n + w.facilities.length, 0);
const health = wards.reduce((n, w) => n + (w.counts.Health ?? 0), 0);
const last = money.years[money.years.length - 1];
const bn = (m) => 'KSh ' + parseFloat((m / 1000).toFixed(2)) + 'B';
---
<Base title="Home" tools={false}>
  <HeroMap slot="hero" />

  <div class="stack-lg" style="padding-top:40px">
    <section class="cols-2 glance" aria-labelledby="money-now">
      <div class="figure">
        <span class="eyebrow" id="money-now">Money · {last.fy}</span>
        <span class="num is-lead">{bn(last.spent)}</span>
        <p class="say">spent by the county, out of a <strong>{bn(last.budget)}</strong> budget. <strong class="hot">{bn(last.budget - last.spent)}</strong> was not spent.</p>
        <SplitBar title={`Development money: roads, buildings, water, ${last.fy}`} parts={[{ value: last.devAbs, label: 'used', tone: 'good' }, { value: 100 - last.devAbs, label: 'not used', tone: 'gap' }]} />
        <p class="source"><EvidenceLabel kind="official" /> Source: Controller of Budget, FY{last.fy}</p>
        <a href="/money/"><strong>The county's money, department by department</strong></a>
      </div>
      {numberNow && <div class="panel sec-harvest"><NumberCard e={numberNow} full={false} /></div>}
    </section>

    <section class="stack" aria-labelledby="places">
      <h2 id="places">The places</h2>
      <div class="tiles">
        <a class="tile" href="/map/"><Icon name="market" size={22} badge /><b>{facilities}</b><span>public places and services listed</span><EvidenceLabel kind="unverified" /></a>
        <a class="tile" href="/map/health/#facilities"><Icon name="health" size={22} badge /><b>{health}</b><span>health facilities in the 2017 national list</span><EvidenceLabel kind="official" /></a>
        <a class="tile" href="/report/"><Icon name="check" size={22} badge /><b>Seen one?</b><span>Tell us what condition a place is in</span></a>
      </div>
      <p class="small muted">Sources: the Nyamira Daily list, mostly not yet checked on site; Kenya Master Health Facility List, 2017 export.</p>
    </section>

    <section class="stack" aria-labelledby="explore">
      <h2 id="explore">Explore</h2>
      <ul class="rows">
        {topics.map((t) => (
          <li><a class="row-link has-ico" href={topicPath[t.slug]}><Icon name={topicIcon[t.slug] ?? 'chart'} size={22} badge /><span style="flex:1"><span class="t">{t.title}</span><span class="d">{t.question}</span></span><span class="go" aria-hidden="true">→</span></a></li>
        ))}
        <li><a class="row-link has-ico" href="/money/contracts/"><Icon name="source" size={22} badge /><span style="flex:1"><span class="t">Contracts</span><span class="d">Every contract we can find: who, how much, when.</span></span><span class="go" aria-hidden="true">→</span></a></li>
      </ul>
    </section>

    <section class="stack">
      <div class="row-head"><span></span><button class="sw-switch" type="button" data-sw-switch aria-pressed="false" hidden>Soma kwa Kiswahili</button></div>
      <div class="sw" lang="sw">
        <span class="eyebrow">Muhtasari kwa Kiswahili</span>
        <p>Nyamira Daily inaeleza kwa lugha rahisi jinsi pesa za kaunti zinavyotumika, huduma zilizopo katika kila wadi, na hali yake. Kila takwimu ina chanzo chake.</p>
      </div>
    </section>
  </div>
</Base>
