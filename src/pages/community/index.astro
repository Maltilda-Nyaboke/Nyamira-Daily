---
// Community (decision #122): the Abagusii, their culture and language. Recorded with consent, kept for the community.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CommunityRules from '../../components/CommunityRules.astro';
import { sections, groupsOf } from '../../nav.js';
const community = sections.find((s) => s.href === '/community/');
---
<Base title="Community" description="The Abagusii, their culture and the Ekegusii language: recorded with consent and kept for the community.">
  <PageHead title="Community" lead="Much of what our elders know has never been written down. We are recording it, with their consent, so it is kept for all of us and for those who come after." />
  <div class="stack-lg" style="margin-top:16px">
    {groupsOf(community).map((g) => (
      <section class="stack">
        <h2>{g.label}</h2>
        <ul class="rows">
          {g.pages.map((p) => <li><a class="row-link" href={p.href}><span><span class="t">{p.label}</span><span class="d">{p.desc}</span></span><span class="go" aria-hidden="true">→</span></a></li>)}
        </ul>
      </section>
    ))}
    <CommunityRules />
  </div>
</Base>
