---
// The Abagusii (decision #122). History and culture only, sourced, several voices, reviewed before publishing.
// Nothing is written here until it has a source and the review panel has checked it.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import CommunityRules from '../../../components/CommunityRules.astro';
import { archiveItems } from '../../../lib/archive.js';
const history = (await archiveItems()).filter((e) => e.data.kind === 'history');
---
<Base title="The Abagusii" description="Who the Abagusii are: history and culture, from named sources.">
  <PageHead title="The Abagusii" lead="Who we are and where we came from, told by our elders and from named sources." />
  <div class="stack-lg" style="margin-top:16px; max-width:760px">
    {history.length > 0 ? (
      <ul class="rows">{history.map((e) => <li><a class="row-link" href={`/community/archive/#${e.id}`}><span><span class="t">{e.data.title}</span><span class="d">{e.data.summary}</span></span><span class="go" aria-hidden="true">→</span></a></li>)}</ul>
    ) : (
      <p class="callout"><span><strong>The first pieces are being prepared.</strong> We publish an account only when it names its source and our review panel has checked it. Nothing is published here yet.</span></p>
    )}
    <section class="stack">
      <h2>What we will cover</h2>
      <ul>
        <li>Where the Abagusii came from and how they settled, as different elders and written sources tell it.</li>
        <li>Clans as heritage: names, totems and customs.</li>
        <li>Everyday culture: food, crafts, songs, naming and ceremonies.</li>
      </ul>
      <p>Do you know an elder we should record, or hold a book, photograph or recording? <a href="/community/share/">Share it with us</a>.</p>
    </section>
    <CommunityRules />
  </div>
</Base>
