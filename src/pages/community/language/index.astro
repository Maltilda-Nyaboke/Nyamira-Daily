---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import CommunityRules from '../../../components/CommunityRules.astro';

const steps = [
  ['Step 1', 'Collect', 'Volunteers record stories, proverbs, songs and everyday speech from speakers who agree to take part.'],
  ['Step 2', 'Write & check', 'Native speakers of Ekegusii transcribe, translate and cross-check every recording.'],
  ['Step 3', 'Record consent', 'Each entry records its source, reviewer and permissions — with a separate yes required for AI training.'],
  ['Step 4', 'Share openly', 'Published for the community, schools and researchers once reviewed (licence being finalised).'],
];
---
<Base title="Ekegusii language" description="An open record of spoken and written Ekegusii, built with speakers' consent, so tools and phones can understand our language.">
  <PageHead
    eyebrow="Community · Language & Open AI"
    title="The open Ekegusii language dataset"
    lead="Phones and computers barely understand Ekegusii because so little of it has been openly documented. We are building a speaker-consented text and speech record together."
    crumbs={[{ href: '/community/', label: 'Community' }, { href: '/community/language/', label: 'Ekegusii language' }]}
  />

  <div class="stack-lg">
    <section class="fg-solid-sheet stack" aria-labelledby="how">
      <div class="fg-sec-head is-compact">
        <span class="fg-kicker">Four-Stage Workflow</span>
        <h2 id="how">How the <span class="fg-hl">Ekegusii dataset</span> is built</h2>
        <p class="small muted">Language tools such as translators come later, using only recordings whose speakers gave separate permission.</p>
      </div>
      <ul class="fg-ticket-grid">
        {steps.map(([no, head, body], i) => (
          <li class={`fg-ticket${i === 0 ? ' is-next' : ''}`}>
            <div class="fg-ticket-stub"><b>{no}</b></div>
            <div class="fg-ticket-body">
              <strong>{head}</strong>
              <p>{body}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="callout"><strong>Current status: nothing published yet.</strong> The first recording rounds are being planned.</p>
      <div class="fg-center-actions">
        <a class="fg-cta-btn" href="/community/share/">Volunteer to record or share</a>
        <a class="fg-outline-btn" href="/community/archive/">See the culture archive</a>
      </div>
    </section>

    <CommunityRules />
  </div>
</Base>
