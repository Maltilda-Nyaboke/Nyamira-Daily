---
// Contracts (decision #116): one page instead of 1,962. Totals by group (county and national money shown apart and
// never added together), the largest contracts in each group, and a search over every contract that loads only
// when used. No page per contractor: a contractor appears only as the name on a public record.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import EvidenceLabel from '../../../components/EvidenceLabel.astro';
import ContractRow from '../../../components/ContractRow.astro';
import { contracts, groups, groupOrder, totals, byGroup } from '../../../lib/contracts.js';
import { ksh } from '../../../lib/fmt.js';

const byG = groupOrder.map((g) => ({ g, info: groups[g], list: byGroup(g), t: totals(byGroup(g)) }));
const largest = (list) => [...list].filter((c) => c.amount != null).sort((a, b) => b.amount - a.amount).slice(0, 5);
const county = byG.filter((x) => !groups[x.g].who.startsWith('National'));
const national = byG.filter((x) => groups[x.g].who.startsWith('National'));
---
<Base title="Contracts" description="Every public contract we can find in Nyamira: county and national, who got it, for how much, and where it says so.">
  <PageHead eyebrow="Money" title="Contracts" lead={`${contracts.length.toLocaleString('en-GB')} contracts and allocations in Nyamira. See who got each one, for how much, and the record that shows it.`} crumbs={[{ href: '/money/', label: 'Money' }, { href: '/money/contracts/', label: 'Contracts' }]} />

  <section class="stack" style="margin-top:24px" aria-labelledby="find">
    <h2 id="find">Find a contract</h2>
    <form class="tk-filters" data-ct-search action="/money/contracts/" method="get">
      <label class="tk-f">Search
        <input type="search" name="q" placeholder="A road, a school, a contractor, a tender number" autocomplete="off" />
      </label>
      <label class="tk-f">Whose money
        <select name="group"><option value="">All</option>{groupOrder.map((g) => <option value={g}>{groups[g].label}</option>)}</select>
      </label>
      <p class="tk-count small muted" data-ct-status aria-live="polite">Type to search all {contracts.length.toLocaleString('en-GB')}. The list loads when you start (about 120 KB).</p>
    </form>
    <ul class="ct-list" data-ct-results></ul>
    <noscript><p class="small">Without JavaScript, download <a href="/files/contracts.csv">every contract as a CSV file</a>.</p></noscript>
    <p class="small"><a href="/files/contracts.csv">Download every contract (CSV)</a> · Licence: CC BY 4.0.</p>
  </section>

  {[['County money', county], ['National money spent in Nyamira', national]].map(([title, list]) => (
    <section class="stack" style="margin-top:32px">
      <h2>{title}</h2>
      {title !== 'County money' && <p class="small muted">National agencies' contracts in Nyamira. This is national money: it is never added to the county's figures.</p>}
      {list.map(({ g, info, list: items, t }) => (
        <details>
          <summary>{info.label}: {t.count.toLocaleString('en-GB')} records{t.withAmount ? `, ${ksh(t.value)} in the ${t.withAmount.toLocaleString('en-GB')} that print an amount` : ''}</summary>
          <p class="small">{info.blurb} Amounts are contract sums or allocations as printed, not money paid.</p>
          <h3 class="mini">The five largest</h3>
          <ul class="ct-list">{largest(items).map((c) => <ContractRow c={c} />)}</ul>
          <p class="small"><a href={`/money/contracts/?group=${g}`}>Search only {info.label}</a></p>
        </details>
      ))}
    </section>
  ))}

  <p class="source" style="margin-top:24px"><EvidenceLabel kind="official" /> From the Public Procurement Information Portal, the county's own reports, KeRRA, KURA, KeNHA and the NG-CDF Board. Each result names its source and page.</p>

  <script>
    const form = document.querySelector('[data-ct-search]');
    const out = document.querySelector('[data-ct-results]');
    const status = document.querySelector('[data-ct-status]');
    const params = new URLSearchParams(location.search);
    const q = form.elements.q, group = form.elements.group;
    q.value = params.get('q') ?? ''; group.value = params.get('group') ?? '';
    const ward = params.get('ward');
    let data = null, loading = null;
    const money = (n) => 'KSh ' + Math.round(n).toLocaleString('en-GB');
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    async function load() {
      if (data) return data;
      loading ??= fetch('/money/contracts/search.json').then((r) => r.json()).then((j) => (data = j));
      return loading;
    }
    function row(c) {
      const who = c.c ? esc(c.c) : c.k === 'allocation' ? esc(c.ag) : c.x ? 'Contractor not shown (private person)' : 'Contractor not named in the source';
      const where = c.w.length ? esc(c.w.join(', ')) + (c.w.length === 1 ? ' Ward' : ' wards') : c.cs ? esc(c.cs) + ' Constituency' : '';
      const src = data.sources[c.s];
      return `<li class="ct-row" id="${esc(c.i.toLowerCase())}"><span class="ct-title">${esc(c.t)}</span><span class="ct-who">${who}</span>`
        + `<span class="ct-amt"><span class="ct-al">${esc(c.al)}</span> <b>${c.a != null ? money(c.a) : 'Not printed'}</b></span>`
        + `<span class="ct-meta">${c.y ? `<span>FY${esc(c.y)}</span>` : ''}${where ? `<span>${where}</span>` : ''}<span>${esc(data.groups[c.g])}${c.n ? ' (national money)' : ''}</span>`
        + `${c.tn ? `<span>Tender ${esc(c.tn)}</span>` : ''}<span>Source: ${src?.u ? `<a href="${esc(src.u)}" rel="noopener">${esc(src.t)}</a>` : esc(src?.t ?? c.s)}${c.p ? `, ${esc(c.p)}` : ''}</span><span>${esc(c.i)}</span></span></li>`;
    }
    async function run() {
      const text = q.value.trim().toLowerCase();
      if (!text && !group.value && !ward) { out.innerHTML = ''; return; }
      status.textContent = 'Loading…';
      await load();
      const words = text.split(/\s+/).filter(Boolean);
      const hits = data.rows.filter((c) => (!group.value || c.g === group.value) && (!ward || c.ws.includes(ward))
        && words.every((w) => [c.i, c.t, c.c, c.ag, c.tn, c.r, c.cs, ...c.w].filter(Boolean).join(' ').toLowerCase().includes(w)));
      out.innerHTML = hits.slice(0, 100).map(row).join('');
      status.textContent = hits.length ? `${hits.length.toLocaleString('en-GB')} found${hits.length > 100 ? ', showing the first 100' : ''}.` : 'Nothing found. Try fewer words.';
    }
    let timer;
    form.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(run, 200); });
    form.addEventListener('submit', (e) => { e.preventDefault(); run(); });
    if (q.value || group.value || ward) run();
  </script>
</Base>
