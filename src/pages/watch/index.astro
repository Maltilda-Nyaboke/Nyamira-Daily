---
// Watch (decisions #110, #117): our videos first (from the sheet's videos tab), then the explainers and the number of
// the week, each with the figures and sources behind it. Only what is published: no promises of future content.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { entries } from '../../lib/content.js';
import { getNumbers, weekOf } from '../../lib/numbers.js';
import { allVideos, videoPath } from '../../lib/videos.js';
import { date } from '../../lib/fmt.js';
const explainers = (await entries('explainers')).sort((a, b) => b.data.updated - a.data.updated);
const numbers = await getNumbers();
---
<Base title="Watch" description="Nyamira Daily's videos, explainers and the number of the week, each with the figures and sources behind it.">
  <PageHead eyebrow="Watch" title="Watch" lead="What we have published, each piece with the figures and sources behind it." crumbs={[{ href: '/watch/', label: 'Watch' }]} />

  {allVideos.length > 0 && (
    <section class="stack" style="margin-top:24px" aria-labelledby="videos">
      <h2 id="videos">Videos</h2>
      <ul class="rows">
        {allVideos.map((v) => <li><a class="row-link" href={videoPath(v.id)}><span><span class="t">{v.title}</span><span class="d">{date(v.published_on)} · {v.summary}</span></span><span class="go" aria-hidden="true">→</span></a></li>)}
      </ul>
    </section>
  )}

  <section class="stack" style="margin-top:24px" aria-labelledby="explainers">
    <h2 id="explainers">Explainers</h2>
    {explainers.length === 0 && <p class="muted">No explainers published yet.</p>}
    <ul class="rows">
      {explainers.map((e) => <li><a class="row-link" href={`/explainers/${e.id}/`}><span><span class="t">{e.data.title}</span><span class="d">{e.data.summary} · updated {date(e.data.updated.toISOString())}</span></span><span class="go" aria-hidden="true">→</span></a></li>)}
    </ul>
  </section>

  {numbers.length > 0 && (
    <section class="stack" style="margin-top:32px" aria-labelledby="numbers">
      <h2 id="numbers">Number of the week</h2>
      <ul class="rows">
        {numbers.map((n) => <li><a class="row-link" href="/number-of-the-week/"><span><span class="t">{n.data.figure}: {n.data.sentence}</span><span class="d">Week of {weekOf(n.data.week)}</span></span><span class="go" aria-hidden="true">→</span></a></li>)}
      </ul>
    </section>
  )}
</Base>
