---
// Partner with us (decision #122): what businesses, NGOs and researchers can do with our data, under two
// public safeguards. Terms and prices are not set: the page says "talk to us". Published data stays CC BY 4.0.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ContactForm from '../../../components/ContactForm.astro';
import { places } from '../../../lib/places.js';
import { contracts } from '../../../lib/contracts.js';
import money from '../../../lib/county-money.js';
const n = (x) => x.toLocaleString('en-GB');
const facilities = places.filter((p) => p.kind === 'facility').length;
---
<Base title="Partner with us" description="Work with Nyamira Daily: data, commissioned research and sponsorship for businesses, NGOs and researchers.">
  <PageHead title="Partner with us" lead="If your business, organisation or research needs to understand Nyamira County, we can help with data you can trace to its source." />
  <div class="stack-lg" style="margin-top:16px; max-width:760px">
    <section class="stack">
      <h2>What we can do together</h2>
      <ul>
        <li><strong>Data for your work.</strong> Extracts and tables shaped for your use, from the records we hold.</li>
        <li><strong>Commissioned research.</strong> Ward surveys, price checks and facility checks, done by our field team.</li>
        <li><strong>Sponsorship.</strong> Support for a show, a section or a community project, clearly labelled.</li>
        <li><strong>Something else.</strong> If you have another use for the data, tell us.</li>
      </ul>
    </section>
    <section class="stack">
      <h2>The data we hold</h2>
      <ul>
        <li><strong>{n(places.length)}</strong> places, including {n(facilities)} public facilities, each with its ward.</li>
        <li><strong>{money.years.length}</strong> years of county budgets and spending, and the 2025/26 budget by department and programme.</li>
        <li><strong>{n(contracts.length)}</strong> county and national contracts and allocations, with sources.</li>
      </ul>
      <p>What we publish is free to reuse with credit (CC BY 4.0). <a href="/about/data/">Download the open data</a> or read the <a href="/about/rules/#terms">terms and reuse</a> page.</p>
    </section>
    <section class="stack">
      <h2>Our two rules</h2>
      <ul>
        <li><strong>No political clients.</strong> We take no money or paid work from political parties, candidates or campaigns.</li>
        <li><strong>Client data is kept apart.</strong> Work we do for a client is labelled as commissioned, and is published only if the client agrees.</li>
      </ul>
    </section>
    <section class="stack">
      <h2>Talk to us</h2>
      <ContactForm topics={['partnership', 'general']} preset="partnership" />
    </section>
  </div>
</Base>
