---
// Tell us (decision #127): one page for everything a reader may want to send. A clear first choice leads to the
// right form: a place goes to its record, a story to the Community team, everything else to the form below.
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ContactForm from '../../../components/ContactForm.astro';
const ways = [
  ['/report/', 'A place you have seen', 'Is the dispensary open? Is the road passable? It goes straight to that place\'s record.'],
  ['/report/clinic/', 'A clinic visit', 'Four quick questions after a visit: medicines, staff, hours and waiting time.'],
  ['/community/share/', 'A story, a song or an elder to record', 'For the culture archive. We get in touch before anything is recorded.'],
  ['#message', 'A tip, a concern or a correction', 'Use the form below. You can leave your name out.'],
];
---
<Base title="Tell us" description="Tell Nyamira Daily about a place, send a tip, a concern, a story or a correction.">
  <PageHead title="Tell us" lead="What would you like to tell us? Pick one, and we will take you to the right form. We read every message and reply as soon as we can." />
  <div class="stack-lg" style="margin-top:16px; max-width:760px">
    <ul class="rows">
      {ways.map(([href, t, d]) => <li><a class="row-link" href={href}><span><span class="t">{t}</span><span class="d">{d}</span></span><span class="go" aria-hidden="true">→</span></a></li>)}
    </ul>
    <section class="stack" id="message">
      <h2>Send a message</h2>
      <ContactForm />
      <p class="small muted">A message is a lead for us to check, not a published fact. If we have named you or your organisation, see your <a href="/about/rules/#right-of-reply">right of reply</a>. Accepted corrections are listed in our <a href="/about/rules/#corrections">corrections log</a>. What we keep: <a href="/about/rules/#privacy">privacy</a>.</p>
    </section>
  </div>
</Base>
