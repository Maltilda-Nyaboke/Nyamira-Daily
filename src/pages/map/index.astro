---
// The county map (decision #55): one map with several views, like layers in a map app.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import AtlasMap from '../../components/AtlasMap.astro';
---
<Base title="Map" description="One map of Nyamira County with views for finding your ward, our facility list and ward project money.">
  <PageHead eyebrow="Map" title="Map of Nyamira" lead="One map, three views. Switch between wards, facilities and ward money; zoom in, and tap a ward to see its details." icon="map" crumbs={[{ href: '/ward/', label: 'Wards' }, { href: '/map/', label: 'Map' }]} />
  <div style="margin-top:16px"><AtlasMap /></div>
</Base>
